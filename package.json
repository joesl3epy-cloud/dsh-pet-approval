{
  "name": "dsh-pet-approval",
  "version": "1.0.0",
  "description": "Pet Approval｜桌宠审批：在桌宠中允许一次普通请求，高风险请求跳转DSH手动审批",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./patch": "./patch.mjs",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "index.js",
    "patch.mjs",
    "install.mjs",
    "uninstall.mjs",
    "check.mjs",
    "cordis.patch.yml",
    "runtime/",
    "test/",
    "LICENSE",
    "README.md",
    "navigation.mjs",
    "lib/",
    "CHANGELOG.md",
    "DEVELOPMENT.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node check.mjs",
    "patch-runtime": "node install.mjs",
    "unpatch-runtime": "node uninstall.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-pet",
    "approval",
    "permission",
    "desktop-pet",
    "electron"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "dsh-pet": ">=0.3.7"
  },
  "peerDependenciesMeta": {
    "dsh-pet": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joesl3epy-cloud/dsh-pet-approval.git"
  },
  "homepage": "https://github.com/joesl3epy-cloud/dsh-pet-approval#readme",
  "bugs": {
    "url": "https://github.com/joesl3epy-cloud/dsh-pet-approval/issues"
  },
  "author": "Jolyon"
}
